# Copy to .env.local. Paste your real Facebook page URL (or edit lib/config.ts directly).
NEXT_PUBLIC_FACEBOOK_PAGE_URL=
# Your production domain, used for social sharing metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Admin panel (/admin) ──
# Strong password for the admin login.
ADMIN_PASSWORD=
# Random secret (32+ characters) used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Added automatically when you connect Upstash Redis in Vercel → Storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
